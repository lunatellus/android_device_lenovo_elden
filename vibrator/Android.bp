cc_binary {
    name: "android.hardware.vibrator-service.elden",
    init_rc: ["android.hardware.vibrator-service.elden.rc"],
    vintf_fragments: ["android.hardware.vibrator-service.elden.xml"],
    relative_install_path: "hw",
    vendor: true,
    srcs: [
        "Vibrator.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "android.hardware.vibrator-V2-ndk",
        "libbase",
        "libbinder_ndk",
    ],
}
