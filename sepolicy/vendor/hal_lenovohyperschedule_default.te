type hal_lenovohyperschedule_default, domain;
hal_server_domain(hal_lenovohyperschedule_default, hal_lenovohyperschedule)

type hal_lenovohyperschedule_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovohyperschedule_default)

allow hal_lenovohyperschedule_default proc_lenovo_hyperschedule:dir search;
allow hal_lenovohyperschedule_default proc_lenovo_hyperschedule:file rw_file_perms;
