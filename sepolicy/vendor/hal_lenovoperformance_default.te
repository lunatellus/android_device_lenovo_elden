type hal_lenovoperformance_default, domain;
hal_server_domain(hal_lenovoperformance_default, hal_lenovoperformance)

type hal_lenovoperformance_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovoperformance_default)

allow hal_lenovoperformance_default sysfs:file rw_file_perms;
allow hal_lenovoperformance_default sysfs_devices_system_cpu:file rw_file_perms;
allow hal_lenovoperformance_default vendor_sysfs_kgsl:file rw_file_perms;
allow hal_lenovoperformance_default vendor_sysfs_kgsl:lnk_file read;
