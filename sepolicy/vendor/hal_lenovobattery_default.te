type hal_lenovobattery_default, domain;
hal_server_domain(hal_lenovobattery_default, hal_lenovobattery)

type hal_lenovobattery_default_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_lenovobattery_default)

allow hal_lenovobattery_default sysfs_batteryinfo:dir search;
allow hal_lenovobattery_default sysfs_batteryinfo:file rw_file_perms;
allow hal_lenovobattery_default vendor_sysfs_battery_supply:dir search;
allow hal_lenovobattery_default vendor_sysfs_battery_supply:file rw_file_perms;
allow hal_lenovobattery_default vendor_sysfs_usb_supply:dir search;
allow hal_lenovobattery_default vendor_sysfs_usb_supply:file rw_file_perms;
