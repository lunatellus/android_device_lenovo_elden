<compatibility-matrix version="8.0" type="framework">
    <hal format="aidl" optional="true">
        <name>android.hardware.media.c2</name>
        <interface>
            <name>IComponentStore</name>
            <instance>dolby</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dms</name>
        <interface>
            <name>IDms</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.dolby.dvs</name>
        <interface>
            <name>IDvs</name>
            <instance>default</instance>
        </interface>
    </hal>
    <hal format="aidl" optional="true">
        <name>vendor.lineage.touch</name>
        <version>1</version>
        <interface>
            <name>IGloveMode</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>